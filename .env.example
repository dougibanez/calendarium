# Base de datos SQLite (no requiere configuración adicional)
DATABASE_URL="file:./prisma/dev.db"

# URL de la aplicación (cambiar en producción)
NEXTAUTH_URL="http://localhost:3000"

# Secreto para NextAuth — generá uno con: openssl rand -base64 32
NEXTAUTH_SECRET="tu-secreto-aqui"

# Credenciales de Google OAuth
# 1. Ir a https://console.cloud.google.com
# 2. Crear proyecto > APIs y servicios > Credenciales > OAuth 2.0
# 3. Agregar URI de redirección: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID="tu-google-client-id"
GOOGLE_CLIENT_SECRET="tu-google-client-secret"
